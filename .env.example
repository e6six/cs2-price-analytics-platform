# Окружение CS2 Index.
#
# Файл описывает все переменные, которые читает приложение (см. src/lib/config.ts).
# Секреты не коммитятся: скопируйте файл в `.env` и заполните только нужное.

# --- База данных -------------------------------------------------------------
# Если DATABASE_URL не задан, приложение поднимает встроенный PostgreSQL (PGlite)
# в каталоге PGLITE_DATA_DIR — это режим для локального запуска и превью.
# DATABASE_URL=postgresql://cs2:cs2@127.0.0.1:5432/cs2_index
# DATABASE_DRIVER=auto            # auto | pg | pglite
PGLITE_DATA_DIR=.cache/pglite
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false

# --- Инициализация данных ----------------------------------------------------
AUTO_MIGRATE=true
AUTO_BOOTSTRAP=true
BOOTSTRAP_DIR=data/bootstrap

# --- Синхронизация через API ------------------------------------------------
# Токен минимум 16 символов; без него POST /api/sync вернёт 401.
# SYNC_TOKEN=change-me-please-16chars
# Разрешить анонимную синхронизацию вне production (только локально).
# ALLOW_ANONYMOUS_SYNC=false
# SYNC_MAX_ITEMS=250

# --- Источники данных --------------------------------------------------------
# Steam: priceoverview доступен без ключа; cookie нужен для полной истории.
# Steam live-запросы идут не чаще 12/мин на процесс, повтор одного предмета — через 120 сек.
# STEAM_WEB_API_KEY=
# STEAM_MARKET_COOKIE=
STEAM_PRICE_REFRESH_COOLDOWN_SECONDS=120
# Массовый обход поиска Steam (источник steam-search): сколько страниц по 100
# позиций брать за прогон и какая пауза между страницами (мс). Продолжение
# обхода — повторным запуском: курсор хранится в журнале в cs2_ingest_runs.
# STEAM_SEARCH_PAGES=100
# STEAM_SEARCH_INTERVAL_MS=3000
# CSFloat: публичные лоты доступны без ключа, ключ поднимает лимиты.
# CSFLOAT_API_KEY=
# LIS-SKINS: массовый JSON price list можно загружать без ключа.
# В экспорте не указана валюта; по умолчанию используется USD (можно поменять).
LISSKINS_PRICE_CURRENCY=USD
# SkinBaron: ключ создаётся в профиле SkinBaron; интеграция использует GetExtendedPriceList.
# SKINBARON_API_KEY=
# Документация GetExtendedPriceList не возвращает валюту — дефолт EUR, проверьте настройки своего аккаунта.
SKINBARON_PRICE_CURRENCY=EUR
# BUFF163 работает только с авторизованной сессией (CNY, ≤10 запросов/мин).
# BUFF_COOKIE=
# DMarket: адаптер не подключён, ключ зарезервирован.
# DMARKET_API_KEY=
# GitHub-датасет Steam-цен (MIT) для массового обновления.
# STEAM_DATASET_REPO=ByMykel/counter-strike-price-tracker
# GITHUB_TOKEN=

# --- Публичный API -----------------------------------------------------------
API_RATE_LIMIT_PER_MINUTE=120
API_CACHE_TTL_SECONDS=60
QUOTE_RETENTION_DAYS=400
LOG_LEVEL=info
