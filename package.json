{
  "name": "cs2-price-analytics-platform",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db/migrate.ts",
    "db:seed": "tsx scripts/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "data:fetch": "tsx scripts/data/fetch-sources.ts",
    "data:bootstrap": "tsx scripts/data/build-bootstrap.ts",
    "sync": "tsx scripts/sync.ts",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "db:stats": "tsx scripts/db/seed.ts --stats"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  },
  "version": "1.0.0"
}
